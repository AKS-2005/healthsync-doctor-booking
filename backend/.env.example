PORT=5000
NODE_ENV=development

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctor_booking
DB_HOST=localhost
DB_PORT=5432
DB_NAME=doctor_booking
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Connection
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=super-secret-doctor-appointment-key-2026-jwt-token
JWT_EXPIRES_IN=7d

# Slot Lock Configuration (in seconds - 5 minutes default)
SLOT_LOCK_TTL=300

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_LOCK_MAX=10
RATE_LIMIT_LOCK_WINDOW=60

# Cache TTL (in seconds)
CACHE_DOCTOR_TTL=600
CACHE_SPECIALIZATIONS_TTL=1800

# Google Gemini AI API Configuration
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
